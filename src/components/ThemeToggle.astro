---
import { localeFromPath, translator } from '../i18n';
import Icon from './Icon.astro';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---
<button id="theme-toggle" class="icon-button" type="button" aria-label={t("Switch to dark theme")} hidden>
  <span class="theme-sun"><Icon name="sun" /></span>
  <span class="theme-moon"><Icon name="moon" /></span>
</button>
