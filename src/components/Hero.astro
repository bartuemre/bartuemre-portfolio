---
import Icon from './Icon.astro';
import AnimatedBackground from './AnimatedBackground.astro';
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">Curious by nature.<br />Building with<br /><span class="accent-text">purpose.</span></h1>
    <p class="hero-description">Cybersecurity, software, and optimization.</p>
    <div class="button-row"><a class="button button-primary" href="/projects/">View projects <Icon /></a><a class="button button-quiet" href="/about/">About me <Icon name="external" /></a></div>
  </div>
  <AnimatedBackground />
</section>
