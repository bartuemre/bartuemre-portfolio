---
import Icon from './Icon.astro';
import AnimatedBackground from './AnimatedBackground.astro';
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="tiny-line"></span> BARTU EMRE / PERSONAL PORTFOLIO</p>
    <h1 id="hero-title">Curious by nature.<br />Building with<br /><span class="accent-text">purpose.</span></h1>
    <p class="hero-description">At the intersection of <strong>cybersecurity</strong>, <strong>software</strong>, and <strong>optimization</strong>.</p>
    <p class="hero-role">Industrial Engineering student.<br />Blue Team & Detection Engineering enthusiast.</p>
    <div class="button-row"><a class="button button-primary" href="/projects/">Explore my projects <Icon /></a><a class="button button-quiet" href="/about/">A little about me <Icon name="external" /></a></div>
  </div>
  <AnimatedBackground />
</section>
<div class="container hero-footnote"><span>LEARNING. CONNECTING. BUILDING.</span><a href="#selected-work">Discover the work <span aria-hidden="true">↓</span></a></div>
