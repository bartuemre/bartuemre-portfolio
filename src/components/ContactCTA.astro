---
import { localeFromPath, translator, localizedPath } from '../i18n';
import Icon from './Icon.astro';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---
<section class:list={['container', 'contact-cta', { 'contact-cta-compact': compact }]} data-reveal><div>{compact ? <h2>{t("Have something in mind?")}</h2> : <><p class="eyebrow">{t("THE NEXT CONVERSATION")}</p><h2>{t("Ideas are better")}<br />{t("when they're shared.")}</h2><p>{t("Interested in security, software, or a problem worth exploring?")}</p></>}</div><a class="button button-primary" href={href("/contact/")}>{t("Let's connect")} <Icon /></a></section>
