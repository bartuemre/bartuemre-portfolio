<div class="gaze-eyes" id="mouse-detective" aria-hidden="true">
  <svg class="gaze-eyes-art" viewBox="0 0 440 150" fill="none">
    <defs><linearGradient id="eye-white" x1="0" y1="0" x2="0" y2="1"><stop stop-color="var(--surface)" /><stop offset="1" stop-color="var(--surface-soft)" /></linearGradient></defs>
    <path d="M18 78c38-61 126-72 184 0-58 72-146 61-184 0Z" fill="url(#eye-white)" stroke="var(--text)" stroke-width="5" />
    <path d="M238 78c58-72 146-61 184 0-38 61-126 72-184 0Z" fill="url(#eye-white)" stroke="var(--text)" stroke-width="5" />
    <ellipse cx="110" cy="78" rx="29" ry="31" fill="var(--accent)" opacity=".23" /><ellipse cx="330" cy="78" rx="29" ry="31" fill="var(--accent)" opacity=".23" />
    <circle class="gaze-pupil" cx="110" cy="78" r="17" fill="var(--text)" /><circle class="gaze-pupil" cx="330" cy="78" r="17" fill="var(--text)" />
    <circle cx="104" cy="71" r="4" fill="var(--surface)" /><circle cx="324" cy="71" r="4" fill="var(--surface)" />
    <path d="M50 31c37-27 82-29 119-6M271 25c37-23 82-21 119 6" stroke="var(--accent)" stroke-width="7" stroke-linecap="round" opacity=".8" />
  </svg>
</div>
<script>
  import { isMotionPaused, onMotionChange } from '../scripts/motion';
  const eyes = document.querySelector<HTMLElement>('.gaze-eyes');
  const pupils = eyes?.querySelectorAll<SVGCircleElement>('.gaze-pupil');
  const pointer = matchMedia('(hover: hover) and (pointer: fine)');
  let frame = 0;
  let position = { x: 0, y: 0 };

  function resetGaze() {
    cancelAnimationFrame(frame);
    frame = 0;
    pupils?.forEach(pupil => pupil.removeAttribute('transform'));
  }
  function moveGaze(event: PointerEvent) {
    if (!eyes || isMotionPaused() || !pointer.matches || event.pointerType === 'touch') return;
    position = { x: event.clientX, y: event.clientY };
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      const box = eyes.getBoundingClientRect();
      if (!box.width) return;
      // Use the untransformed eye centers so movement cannot feed back into itself.
      pupils?.forEach((pupil, index) => {
        const dx = position.x - (box.left + box.width * (index === 0 ? .25 : .75));
        const dy = position.y - (box.top + box.height * .52);
        const distance = Math.hypot(dx, dy) || 1;
        const amount = Math.min(11, distance / 26);
        pupil.setAttribute('transform', `translate(${dx / distance * amount} ${dy / distance * amount})`);
      });
    });
  }
  window.addEventListener('pointermove', moveGaze, { passive: true });
  document.documentElement.addEventListener('pointerleave', resetGaze);
  onMotionChange(resetGaze);
  pointer.addEventListener('change', resetGaze);
</script>
