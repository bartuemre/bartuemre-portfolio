---
import { localeFromPath, translator } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---
<div class="systems-map">
  <svg class="orbital-map" viewBox="0 0 480 420" fill="none" aria-hidden="true">
    <defs>
      <radialGradient id="ambient" cx="50%" cy="45%"><stop stop-color="var(--accent)" stop-opacity=".22" /><stop offset=".55" stop-color="var(--accent)" stop-opacity=".05" /><stop offset="1" stop-color="var(--accent)" stop-opacity="0" /></radialGradient>
      <linearGradient id="core" x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--surface)" /><stop offset="1" stop-color="var(--surface-soft)" /></linearGradient>
      <clipPath id="core-avatar-clip"><circle cx="240" cy="210" r="21" /></clipPath>
      <clipPath id="orbit-avatar-clip"><circle cx="376" cy="163" r="20" /></clipPath>
      <filter id="soft-glow" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="6" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
      <filter id="particle-glow" x="-150%" y="-150%" width="400%" height="400%"><feGaussianBlur stdDeviation="2.5" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
    </defs>
    <circle cx="240" cy="210" r="205" fill="url(#ambient)" />
    <g class="orbital-grid" stroke="currentColor" opacity=".18"><path d="M30 210h420M240 15v390" stroke-dasharray="3 8" /><circle cx="240" cy="210" r="164" /><circle cx="240" cy="210" r="118" /><circle cx="240" cy="210" r="65" /></g>
    <g class="atom-orbit atom-orbit-a"><ellipse cx="240" cy="210" rx="164" ry="58" transform="rotate(-28 240 210)" /><circle class="orbit-particle particle-a" cx="398" cy="136" r="5" /><circle class="particle-halo" cx="398" cy="136" r="11" /></g>
    <g class="atom-orbit atom-orbit-b"><ellipse cx="240" cy="210" rx="144" ry="48" transform="rotate(32 240 210)" /><circle class="orbit-particle particle-b" cx="116" cy="132" r="4" /><circle class="particle-halo" cx="116" cy="132" r="10" /></g>
    <g class="atom-orbit atom-orbit-c"><ellipse cx="240" cy="210" rx="178" ry="72" transform="rotate(82 240 210)" /><circle class="orbit-particle particle-c" cx="240" cy="32" r="4.5" /><circle class="particle-halo" cx="240" cy="32" r="10" /></g>
    <g class="core-system" filter="url(#soft-glow)"><circle cx="240" cy="210" r="58" fill="var(--surface-soft)" opacity=".72" /><circle cx="240" cy="210" r="42" fill="url(#core)" stroke="var(--accent)" stroke-width="2" /><circle cx="240" cy="210" r="30" stroke="var(--accent)" stroke-opacity=".5" stroke-dasharray="2 5" /></g>
    <g class="profile-orbit" fill="none">
      <path class="star-orbit" d="M240 94 L270 158 L339 166 L287 211 L305 280 L240 242 L175 280 L193 211 L141 166 L210 158 Z" />
      <path class="star-orbit" d="M240 105 L277 180 L320 138 L300 205 L359 228 L294 236 L278 302 L240 248 L202 302 L186 236 L121 228 L180 205 L160 138 L203 180 Z" />
      <path class="star-orbit" d="M240 116 L257 177 L324 164 L274 207 L322 263 L257 244 L240 306 L223 244 L158 263 L206 207 L156 164 L223 177 Z" />
      <g class="orbit-avatar"><image class="core-avatar" href="/images/profile-v4.png" x="219" y="189" width="42" height="42" preserveAspectRatio="xMidYMid slice" clip-path="url(#core-avatar-clip)" /><animateMotion id="profile-motion" begin="indefinite" dur="14s" repeatCount="indefinite" rotate="0" path="M0 -116 L30 -52 L99 -44 L47 1 L65 70 L0 32 L-65 70 L-47 1 L-99 -44 L-30 -52 Z" /></g>
    </g>
    <g class="system-card" fill="var(--surface)" stroke="var(--accent)" stroke-opacity=".7"><rect x="96" y="126" width="114" height="43" rx="7" /><rect x="300" y="166" width="114" height="43" rx="7" /><rect x="183" y="278" width="135" height="43" rx="7" /></g>
    <g class="system-card-text" fill="var(--text)" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" letter-spacing=".2"><text x="153" y="152">{t("SECURITY")}</text><text x="357" y="192">{t("SOFTWARE")}</text><text x="250" y="304">{t("OPTIMIZATION")}</text></g>
    <g class="status-nodes" fill="var(--success)" filter="url(#particle-glow)"><circle cx="96" cy="126" r="3" /><circle cx="414" cy="188" r="3" /><circle cx="250" cy="321" r="3" /></g>
  </svg>
  <div class="map-controls">
    <span>{t('Three fields. Shared questions.')}</span>
    <button class="motion-toggle" type="button" data-pause-label={t('Pause animation')} data-play-label={t('Play animation')} data-system-label={t('Reduced motion is on')} hidden>{t('Pause animation')}</button>
  </div>
  <script>
    import { isMotionPaused, motionIsSystemReduced, onMotionChange, setMotionPaused } from '../scripts/motion';
    const map = document.querySelector<HTMLElement>('.systems-map');
    const svg = document.querySelector<SVGSVGElement>('.orbital-map');
    const toggle = document.querySelector<HTMLButtonElement>('.motion-toggle');
    const profileMotion = document.getElementById('profile-motion') as SVGAnimateMotionElement | null;
    const starPaths = [
      'M0 -116 L30 -52 L99 -44 L47 1 L65 70 L0 32 L-65 70 L-47 1 L-99 -44 L-30 -52 Z',
      'M0 -105 L37 -30 L80 -72 L60 -5 L119 18 L54 26 L38 92 L0 38 L-38 92 L-54 26 L-119 18 L-60 -5 L-80 -72 L-37 -30 Z',
      'M0 -94 L17 -33 L84 -46 L34 -3 L82 53 L17 34 L0 96 L-17 34 L-82 53 L-34 -3 L-84 -46 L-17 -33 Z',
    ];
    let timer: ReturnType<typeof setInterval> | undefined;
    let inView = true;
    let started = false;
    let previous = -1;
    function updatePlayback() {
      const paused = isMotionPaused();
      const suspended = paused || document.hidden || !inView;
      if (map) map.dataset.suspended = String(suspended);
      if (toggle) {
        toggle.hidden = false;
        toggle.disabled = motionIsSystemReduced();
        toggle.textContent = motionIsSystemReduced() ? toggle.dataset.systemLabel! : paused ? toggle.dataset.playLabel! : toggle.dataset.pauseLabel!;
      }
      clearInterval(timer);
      timer = undefined;
      if (suspended) {
        svg?.pauseAnimations();
        return;
      }
      svg?.unpauseAnimations();
      if (!started) { profileMotion?.beginElement(); started = true; }
      timer = setInterval(() => {
        let next = Math.floor(Math.random() * starPaths.length);
        while (next === previous) next = Math.floor(Math.random() * starPaths.length);
        previous = next;
        profileMotion?.setAttribute('path', starPaths[next]);
        profileMotion?.beginElement();
      }, 14000);
    }
    onMotionChange(updatePlayback);
    toggle?.addEventListener('click', () => setMotionPaused(!isMotionPaused()));
    document.addEventListener('visibilitychange', updatePlayback);
    if (map && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; updatePlayback(); }).observe(map);
    }
    window.addEventListener('pagehide', () => { clearInterval(timer); svg?.pauseAnimations(); });
    window.addEventListener('pageshow', updatePlayback);
  </script>
</div>
