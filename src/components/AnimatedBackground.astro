---
---
<div class="systems-map" aria-hidden="true">
  <svg class="orbital-map" viewBox="0 0 480 420" fill="none" role="presentation">
    <defs>
      <radialGradient id="ambient" cx="50%" cy="45%"><stop stop-color="var(--accent)" stop-opacity=".22" /><stop offset=".55" stop-color="var(--accent)" stop-opacity=".05" /><stop offset="1" stop-color="var(--accent)" stop-opacity="0" /></radialGradient>
      <linearGradient id="core" x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--surface)" /><stop offset="1" stop-color="var(--surface-soft)" /></linearGradient>
      <clipPath id="core-avatar-clip"><circle cx="240" cy="210" r="27" /></clipPath>
      <clipPath id="orbit-avatar-clip"><circle cx="376" cy="163" r="20" /></clipPath>
      <filter id="soft-glow" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="6" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
      <filter id="particle-glow" x="-150%" y="-150%" width="400%" height="400%"><feGaussianBlur stdDeviation="2.5" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
    </defs>
    <circle cx="240" cy="210" r="205" fill="url(#ambient)" />
    <g class="orbital-grid" stroke="currentColor" opacity=".18"><path d="M30 210h420M240 15v390" stroke-dasharray="3 8" /><circle cx="240" cy="210" r="164" /><circle cx="240" cy="210" r="118" /><circle cx="240" cy="210" r="65" /></g>
    <g class="atom-orbit atom-orbit-a"><ellipse cx="240" cy="210" rx="164" ry="58" transform="rotate(-28 240 210)" /><circle class="orbit-particle particle-a" cx="398" cy="136" r="5" /><circle class="particle-halo" cx="398" cy="136" r="11" /></g>
    <g class="atom-orbit atom-orbit-b"><ellipse cx="240" cy="210" rx="144" ry="48" transform="rotate(32 240 210)" /><circle class="orbit-particle particle-b" cx="116" cy="132" r="4" /><circle class="particle-halo" cx="116" cy="132" r="10" /></g>
    <g class="atom-orbit atom-orbit-c"><ellipse cx="240" cy="210" rx="178" ry="72" transform="rotate(82 240 210)" /><circle class="orbit-particle particle-c" cx="240" cy="32" r="4.5" /><circle class="particle-halo" cx="240" cy="32" r="10" /></g>
    <g class="core-system" filter="url(#soft-glow)"><circle cx="240" cy="210" r="58" fill="var(--surface-soft)" opacity=".72" /><circle cx="240" cy="210" r="42" fill="url(#core)" stroke="var(--accent)" stroke-width="2" /><circle cx="240" cy="210" r="30" stroke="var(--accent)" stroke-opacity=".5" stroke-dasharray="2 5" /><text x="240" y="216" text-anchor="middle" fill="var(--text)" font-size="20" font-family="var(--font-display)" font-weight="600">be.</text></g>
    <g class="profile-orbit"><ellipse cx="240" cy="210" rx="128" ry="48" transform="rotate(-24 240 210)" /><image class="core-avatar orbit-avatar" href="https://avatars.githubusercontent.com/u/126015307?v=4" x="355" y="142" width="42" height="42" preserveAspectRatio="xMidYMid slice" clip-path="url(#orbit-avatar-clip)" /></g>
    <g class="system-card" fill="var(--surface)" stroke="var(--accent)" stroke-opacity=".7"><rect x="96" y="126" width="114" height="43" rx="7" /><rect x="300" y="166" width="114" height="43" rx="7" /><rect x="183" y="278" width="135" height="43" rx="7" /></g>
    <g class="system-card-text" fill="var(--text)" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" letter-spacing=".2"><text x="153" y="152">SECURITY</text><text x="357" y="192">SOFTWARE</text><text x="250" y="304">OPTIMIZATION</text></g>
    <g class="status-nodes" fill="var(--success)" filter="url(#particle-glow)"><circle cx="96" cy="126" r="3" /><circle cx="414" cy="188" r="3" /><circle cx="250" cy="321" r="3" /></g>
  </svg>
</div>
