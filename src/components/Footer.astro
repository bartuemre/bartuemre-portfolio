---
import { localeFromPath, translator, localizedPath } from '../i18n';
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---
<footer class="site-footer">
  <div class="container footer-main"><a href={href("/")} class="wordmark">Bartu Emre<span class="brand-dot">.</span></a><p>{t("Curiosity, built into practice.")}</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={17} /><span class="sr-only"> {t("(opens in a new tab)")}</span></a></div>
  <div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} Bartu Emre</span><span>{t("Cybersecurity · Software · Optimization")}</span><a href="#top">{t("Back to top ↑")}</a></div>
</footer>
