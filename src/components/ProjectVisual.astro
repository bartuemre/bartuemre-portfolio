---
interface Props { kind: 'soc' | 'research' | 'iprv'; compact?: boolean; }
const { kind, compact = false } = Astro.props;
---
<div class:list={['project-visual', `visual-${kind}`]} aria-hidden="true">
  <div class="visual-caption">{!compact && <span>{kind === 'soc' ? '01 / DECISION SYSTEMS' : '02 / RESEARCH WORKFLOWS'}</span>}<span>CONCEPT DIAGRAM</span></div>
  {kind === 'soc' ? <svg viewBox="0 0 520 200" fill="none"><g stroke="currentColor" stroke-opacity=".35"><path d="M100 50h85l70 50h70M100 100h225M100 150h85l70-50M325 100l70-50h28M325 100h98M325 100l70 50h28" /></g><g fill="var(--surface)" stroke="var(--accent)"><rect x="57" y="32" width="92" height="36" rx="4" /><rect x="57" y="82" width="92" height="36" rx="4" /><rect x="57" y="132" width="92" height="36" rx="4" /><rect x="218" y="67" width="100" height="66" rx="4" /><circle cx="425" cy="50" r="17" /><circle cx="425" cy="100" r="17" /><circle cx="425" cy="150" r="17" /></g><g fill="var(--text)" font-family="monospace" font-size="10" text-anchor="middle"><text x="103" y="54">PRIORITY</text><text x="103" y="104">SKILLS</text><text x="103" y="154">SLA</text><text x="268" y="97">ASSIGNMENT</text><text x="268" y="113">MODEL</text><text x="425" y="54">A</text><text x="425" y="104">B</text><text x="425" y="154">C</text></g></svg> : kind === 'iprv' ? <svg viewBox="0 0 520 200" fill="none"><circle cx="260" cy="100" r="70" stroke="var(--accent)" stroke-opacity=".3" stroke-dasharray="5 8" /><circle cx="260" cy="100" r="42" fill="var(--surface)" stroke="var(--accent)" /><path d="M229 108h62M238 92h44M248 76h24M238 124h44" stroke="var(--text)" stroke-width="3" stroke-linecap="round" /><path d="M120 38h60M340 162h60M84 100h40M396 100h40" stroke="var(--accent)" stroke-opacity=".6" /><text x="260" y="184" text-anchor="middle" fill="var(--muted)" font-family="monospace" font-size="10">EVIDENCE · CONTEXT · VERDICT</text></svg> : <svg viewBox="0 0 520 200" fill="none"><g stroke="var(--accent)" stroke-opacity=".5"><rect x="137" y="22" width="240" height="142" rx="5" transform="rotate(6 257 93)" /><rect x="129" y="27" width="240" height="142" rx="5" transform="rotate(-4 249 98)" /></g><rect x="120" y="34" width="260" height="142" rx="5" fill="var(--surface)" stroke="var(--accent)" /><path d="M120 65h260" stroke="var(--accent)" stroke-opacity=".4" /><circle cx="138" cy="49" r="3" fill="var(--success)" /><g fill="var(--text)" font-family="monospace" font-size="10"><text x="151" y="53">LITERATURE EXPLORER</text><text x="140" y="92">DISCOVER → FILTER → EXPLORE</text></g><g stroke="var(--muted)" stroke-opacity=".4"><path d="M140 110h175M140 121h211M140 132h142" /></g><g fill="var(--accent)" font-family="monospace" font-size="10"><text x="140" y="157">DOI</text><text x="202" y="157">PDF</text><text x="264" y="157">CSV</text></g></svg>}
</div>
