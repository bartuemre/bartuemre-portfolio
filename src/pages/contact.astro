---
import { localeFromPath, translator } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---
<BaseLayout title={t("Contact")} description={t("Find Bartu Emre on GitHub and explore his work in cybersecurity, software, and optimization.")}>
  <PageHeading eyebrow={t("CONTACT / START A CONVERSATION")} title={t("Good work starts with curiosity.")} description={t("If our interests overlap — security, software, or optimization — explore what I'm working on and find me on GitHub.")} />
  <section class="container contact-grid section-bottom" aria-labelledby="find-me">
    <div>
      <h2 id="find-me">{t("Find me online")}<span class="accent-text">.</span></h2>
      <p class="section-intro mt-4">{t("My public projects and profile,")}<br />{t("in one place.")}</p>
    </div>
    <div class="contact-links">
      <a class="contact-link" href={profile.github} target="_blank" rel="noopener noreferrer">
        <div><span class="eyebrow">{t("CODE & PROJECTS")}</span><h3>GitHub</h3><span>github.com/bartuemre</span></div>
        <Icon name="external" size={30} /><span class="sr-only"> {t("(opens in a new tab)")}</span>
      </a>
      <a class="contact-link" href={profile.tryhackme} target="_blank" rel="noopener noreferrer">
        <div><span class="eyebrow">{t("CYBERSECURITY PRACTICE")}</span><h3>TryHackMe</h3><span>tryhackme.com/p/ceobey</span></div>
        <Icon name="external" size={30} /><span class="sr-only"> {t("(opens in a new tab)")}</span>
      </a>
      {profile.linkedin && <a class="contact-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="external" /><span class="sr-only"> {t("(opens in a new tab)")}</span></a>}
      <a class="contact-link" href={`mailto:${profile.email}`}>
        <div><span class="eyebrow">{t("EMAIL")}</span><h3>{t("Send an email")}</h3><span>{profile.email}</span></div>
        <Icon name="arrow" size={30} />
      </a>
      {profile.resume && <a class="contact-link" href={profile.resume}>{t("View résumé")} <Icon /></a>}
    </div>
  </section>
</BaseLayout>
