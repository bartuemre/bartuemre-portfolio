---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import { focusAreas } from '../data/profile';
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Cybersecurity, Software & Optimization">
  <Hero />
  <section class="section container" id="selected-work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-title">Ideas into practice<span class="accent-text">.</span></h2></div><a class="text-link" href="/projects/">All projects <Icon /></a></div>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </section>
  <section class="focus-section section" aria-labelledby="focus-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / AREAS OF FOCUS</p><h2 id="focus-title">Different lenses.<br />Connected thinking.</h2></div><p class="section-intro">Three disciplines shaping how I learn,<br />approach problems, and build.</p></div><div class="focus-grid">{focusAreas.map((focus) => <article class="focus-item" data-reveal><span class="focus-number">{focus.number} /</span><h3>{focus.title}</h3><p class="focus-subtitle">{focus.subtitle}</p><p>{focus.description}</p><span class="microcopy">{focus.tags}</span></article>)}</div></div></section>
  <ContactCTA />
</BaseLayout>
