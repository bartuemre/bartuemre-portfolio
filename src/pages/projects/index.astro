---
import { localeFromPath, translator } from '../../i18n';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const projects = (await getCollection(locale === 'tr' ? 'projectsTr' : 'projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={t("Projects")} description={t("Explore Bartu Emre's projects in security decision support, optimization, and literature research software.")}>
  <PageHeading eyebrow={t("PROJECTS / IDEAS INTO PRACTICE")} title={t("Built around a question.")} description={t("A growing collection of projects across cybersecurity, software, and optimization. Each one starts with something worth understanding.")} />
  <section class="container section-bottom" id="selected-work" aria-labelledby="project-list-heading"><div class="collection-topline"><h2 id="project-list-heading">{t("Selected work")}</h2><span class="microcopy">{String(projects.length).padStart(2, '0')} {t("PROJECTS / WORK IN PROGRESS")}</span></div><div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div><p class="collection-note">{t("Project pages describe their current scope and status. Repository links appear where available.")}</p></section>
  <ContactCTA />
</BaseLayout>
