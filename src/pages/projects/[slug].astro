---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Icon from '../../components/Icon.astro';
import IprvEmbed from '../../components/IprvEmbed.astro';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---
<BaseLayout title={data.title} description={data.summary}>
  <header class="page-heading container"><a class="back-link" href="/projects/">← All projects</a><p class="eyebrow">{data.category}</p><h1>{data.title}</h1><p class="page-description">{data.summary}</p><p class="detail-status"><span class="status-dot" aria-hidden="true"></span>{data.status}</p></header>
  <div class="container detail-visual"><ProjectVisual kind={data.visual} /></div>
  {project.id === 'iprv' && <div class="container section"><IprvEmbed /></div>}
  <div class="container detail-grid section"><article class="prose"><Content /></article><aside class="project-sidebar" aria-label="Project information"><p class="eyebrow">PROJECT NOTES</p><h2>At a glance</h2><dl><dt>Focus</dt><dd>{data.category}</dd><dt>Status</dt><dd>{data.status}</dd></dl><ul class="tag-list" aria-label="Project topics">{data.tags.map((tag) => <li>{tag}</li>)}</ul><div class="project-links">{data.demo ? <a class="button button-primary" href={data.demo} target="_blank" rel="noopener noreferrer">Go project <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a> : data.repository ? <a class="button button-primary" href={data.repository} target="_blank" rel="noopener noreferrer">View repository <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a> : <p class="unavailable">Project link not yet available.</p>}</div></aside></div>
  <div class="container section-bottom"><a class="text-link" href="/projects/">← Back to the collection</a></div>
</BaseLayout>
