---
import { localeFromPath, translator } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ComingSoon from '../components/ComingSoon.astro';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---
<BaseLayout title={t("Security Lab")} description={t("A future home for Bartu Emre's Blue Team and detection engineering lab notes. No writeups published yet.")}><PageHeading eyebrow={t("SECURITY LAB / LEARN BY EXPLORING")} title={t("From observation to understanding.")} description={t("A space for hands-on learning, questions, and technical notes on the defensive side of security.")} /><ComingSoon type="lab" /></BaseLayout>
