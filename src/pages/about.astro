---
import { localeFromPath, translator, localizedPath } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { focusAreas, profile } from '../data/profile';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---
<BaseLayout title={t("About")} description={t("Meet Bartu Emre, an Industrial Engineering student interested in Blue Team, detection engineering, software, and optimization.")}>
  <PageHeading eyebrow={t("ABOUT / THE PERSON BEHIND THE WORK")} title={t("A systems mindset. An open mind.")} description={t("I'm Bartu, an Industrial Engineering student exploring the connections between security, software, and better decisions.")} />
  <section class="container about-grid section-bottom"><div class="about-statement"><span class="eyebrow">{t("MY PERSPECTIVE")}</span><p>{t("Understand the problem.")}<br />{t("Explore the connections.")}<br /><span class="accent-text">{t("Build from there.")}</span></p><span class="microcopy">{t("LEARNING IN PUBLIC, ONE PROJECT AT A TIME.")}</span></div><div class="prose"><h2>{t("Where my interests meet")}</h2><p>{t("Industrial Engineering gives me a way to think about systems: their constraints, the resources they depend on, and the decisions that shape their outcomes.")}</p><p>{t("I'm interested in bringing that perspective to cybersecurity, particularly Blue Team and detection engineering, while developing software that helps make information useful.")}</p><p>{t("My current academic project, SOC Decision Lab, sits at that intersection. It explores alert prioritization and analyst assignment as an optimization and decision-support problem.")}</p><a class="text-link" href={href("/projects/soc-decision-lab/")}>{t("Explore SOC Decision Lab →")}</a><h2>{t("Still learning. Always curious.")}</h2><p>{t("This portfolio is a place to document projects and, over time, share technical writeups. It reflects work in progress and the questions I'm exploring.")}</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">{t("Follow the work on GitHub ↗")}<span class="sr-only"> {t("(opens in a new tab)")}</span></a></div></section>
  <section class="focus-section section"><div class="container"><h2 class="mb-10">{t("What I'm exploring")}</h2><div class="focus-grid">{focusAreas.map((focus) => <article class="focus-item"><span class="focus-number">{focus.number} /</span><h3>{t(focus.title)}</h3><p>{t(focus.description)}</p></article>)}</div></div></section>
  <ContactCTA />
</BaseLayout>
