---
import { localeFromPath, translator, localizedPath } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { focusAreas, profile } from '../data/profile';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---
<BaseLayout title={t("About")} description={t("Meet Bartu Emre, an Industrial Engineering student at Eskişehir Osmangazi University focused on Blue Team, detection engineering, and SOC operations.")}>
  <PageHeading
    eyebrow={t("ABOUT")}
    title={t("Who I am")}
    description={t("I'm Bartu, an Industrial Engineering student at Eskişehir Osmangazi University focused on Blue Team, detection engineering, and SOC operations.")}
  />
  <section class="container about-grid section-bottom" aria-labelledby="about-background">
    <dl class="about-facts">
      <div><dt>{t("Education")}</dt><dd>{t("Industrial Engineering · Eskişehir Osmangazi University")}</dd></div>
      <div><dt>{t("Current focus")}</dt><dd>{t("Blue Team · Detection Engineering · SOC")}</dd></div>
      <div><dt>{t("Graduation thesis")}</dt><dd>{t("SOC alert assignment and scheduling optimization")}</dd></div>
    </dl>
    <div class="prose">
      <h2 id="about-background">{t("Background and current work")}</h2>
      <p>{t("My Industrial Engineering studies give me a systems engineering perspective on constraints, resources, and decisions across complex processes.")}</p>
      <p>{t("My main focus is Blue Team work, especially detection engineering and SOC operations. My earlier work includes Red Team and penetration testing, along with Arduino, robotics, and coding. Those experiences broadened my view of how systems are built and how they can be defended.")}</p>
      <p>{t("My current graduation thesis focuses on optimizing SOC alert assignment and scheduling. In SOC Decision Lab, I model how alerts can be assigned to analysts under skill, shift, and SLA constraints. The model and evaluation are still in development.")}</p>
      <a class="text-link" href={href("/projects/soc-decision-lab/")}>{t("Explore SOC Decision Lab →")}</a>
      <a class="text-link about-github" href={profile.github} target="_blank" rel="noopener noreferrer">{t("GitHub profile ↗")}<span class="sr-only"> {t("(opens in a new tab)")}</span></a>
    </div>
  </section>
  <section class="focus-section section"><div class="container"><h2 class="mb-10">{t("Areas of work")}</h2><div class="focus-grid">{focusAreas.map((focus) => <article class="focus-item"><span class="focus-number">{focus.number} /</span><h3>{t(focus.title)}</h3><p>{t(focus.description)}</p></article>)}</div></div></section>
</BaseLayout>
