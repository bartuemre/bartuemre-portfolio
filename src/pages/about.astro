---
import { localeFromPath, translator, localizedPath } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { focusAreas, profile } from '../data/profile';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---
<BaseLayout title={t("About")} description={t("Meet Bartu Emre, an Industrial Engineering student at Eskişehir Osmangazi University focused on Blue Team, detection engineering, and SOC operations.")}>
  <PageHeading eyebrow={t("ABOUT / THE PERSON BEHIND THE WORK")} title={t("A systems mindset. An open mind.")} description={t("I'm Bartu, an Industrial Engineering student at Eskişehir Osmangazi University focused on Blue Team, detection engineering, and SOC operations.")} />
  <section class="container about-grid section-bottom"><div class="about-statement"><span class="eyebrow">{t("MY PERSPECTIVE")}</span><p>{t("Understand the problem.")}<br />{t("Explore the connections.")}<br /><span class="accent-text">{t("Build from there.")}</span></p><span class="microcopy">{t("LEARNING IN PUBLIC, ONE PROJECT AT A TIME.")}</span></div><div class="prose"><h2>{t("Where my interests meet")}</h2><p>{t("I study Industrial Engineering at Eskişehir Osmangazi University. Its systems engineering perspective helps me think about constraints, resources, and decisions across complex processes.")}</p><p>{t("My main focus is Blue Team work, especially detection engineering and SOC operations. My earlier work includes Red Team and penetration testing, along with Arduino, robotics, and coding. Those experiences broadened my view of how systems are built and how they can be defended.")}</p><p>{t("My current graduation thesis focuses on optimizing SOC alert assignment and scheduling. In SOC Decision Lab, I model how alerts can be assigned to analysts under skill, shift, and SLA constraints. The model and evaluation are still in development.")}</p><a class="text-link" href={href("/projects/soc-decision-lab/")}>{t("Explore SOC Decision Lab →")}</a><h2>{t("Still learning. Always curious.")}</h2><p>{t("This portfolio is a place to document projects and, over time, share technical writeups. It reflects work in progress and the questions I'm exploring.")}</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">{t("Follow the work on GitHub ↗")}<span class="sr-only"> {t("(opens in a new tab)")}</span></a></div></section>
  <section class="focus-section section"><div class="container"><h2 class="mb-10">{t("What I'm exploring")}</h2><div class="focus-grid">{focusAreas.map((focus) => <article class="focus-item"><span class="focus-number">{focus.number} /</span><h3>{t(focus.title)}</h3><p>{t(focus.description)}</p></article>)}</div></div></section>
  <ContactCTA />
</BaseLayout>
